{
  "author": "Ragaeeb Haq",
  "bugs": {
    "url": "https://github.com/ragaeeb/kokokor/issues"
  },
  "description": "A lightweight TypeScript library designed to reconstruct paragraphs from OCRed inputs.",
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.2.0",
    "semantic-release": "^25.0.9",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.3.9",
    "node": ">=24.0.0"
  },
  "files": [
    "dist",
    "LICENSE.md",
    "README.md"
  ],
  "homepage": "https://github.com/ragaeeb/kokokor",
  "keywords": [
    "nodejs",
    "ocr",
    "formatting",
    "paragraphs",
    "text-processing",
    "typescript"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "name": "kokokor",
  "packageManager": "bun@1.3.9",
  "repository": {
    "type": "git",
    "url": "https://github.com/ragaeeb/kokokor.git"
  },
  "scripts": {
    "build": "tsdown",
    "format": "biome format --write",
    "lint": "biome check",
    "postbuild": "bun run test:exports",
    "review:diff": "git diff main -- src test/exports.test.ts > review-diff.txt",
    "snap": "WRITE_SNAPSHOTS=true bun test",
    "test:exports": "bun test test/exports.test.ts"
  },
  "source": "src/index.ts",
  "type": "module",
  "types": "dist/index.d.ts",
  "version": "2.2.1"
}
