  "observations": [
    {
      "bbox": {
        "y": 50.971,
        "width": 661.681,
        "height": 43.975,
        "x": 415.474
      },
      "text": "إرشاد المريد إلى مقاصد ومعاني كتاب التوحيد (ج٢)"
    },
    {
      "text": "بَابُ: التَّسَمِّي بِقَاضِي القُضَاةِ وَنَحوِهِ.",
      "bbox": {
        "x": 553.537,
        "height": 84.677,
        "y": 169.307,
        "width": 465.06
      }
    },
    {
      "text": "الشرح ب٢",
      "bbox": {
        "width": 166.703,
        "y": 299.83,
        "height": 59.327,
        "x": 479.591
      }
    },
    {
      "bbox": {
        "width": 886.066,
        "y": 393.187,
        "height": 74.762,
        "x": 124.935
      },
      "text": "وهذا البابُ أيضًا مُتعلق بالأمُور التي فيها كمال التوحيد، وتعظيم الرَّب،"
    },
    {
      "text": "وفي ضدِّها مُنَافاة لكمال التَّوحيد.",
      "bbox": {
        "x": 648.286,
        "width": 414.539,
        "y": 464.646,
        "height": 70.167
      }
    },
    {
      "text": "وهذا البابُ في التسَمِّي بأسماء تُنافي الأدب مع اللّٰه سُبحَانَهُ وَتَعَالَى؛ ولذلك",
      "bbox": {
        "y": 559.259,
        "width": 874.547,
        "height": 74.397,
        "x": 130.797
      }
    },
    {
      "text": "قال الشيخ رَحَمَهُ ٱللَّهُ:",
      "bbox": {
        "y": 644.713,
        "width": 241.884,
        "x": 815.157,
        "height": 59.978
      }
    },
    {
      "bbox": {
        "height": 82.977,
        "x": 122.725,
        "width": 883.026,
        "y": 723.575
      },
      "text": "(بَابُ التَّسَمِّي بِقَاضِي القُضَاةِ وَنَحوِه): أي: حُكم التسَمِّي بقاضي القضَاة"
    },
    {
      "bbox": {
        "width": 649.901,
        "height": 66.329,
        "y": 807.789,
        "x": 404.606
      },
      "text": "ونحوه؛ سَواء تسَمَّىٰ به هو، أو سَمَّاه غيره ورَضي هو به."
    },
    {
      "bbox": {
        "y": 892.515,
        "width": 870.372,
        "height": 75.903,
        "x": 130.251
      },
      "text": "وهذا الحُكمُ يُؤخَذ من الأدلة، وقد دَلَّت الأدلة علىٰ أنه حَرَام، ويُنافي كمال"
    },
    {
      "bbox": {
        "width": 448.815,
        "y": 982.443,
        "height": 46.285,
        "x": 607.823
      },
      "text": "التوحيد، كمَا يتَبَيَّن إن شاء اللٰه عَزَّوَجَلَّ."
    },
    {
      "text": "وذلك أن هذه الأسمَاء فيها وَصفُ المخلوقِ بالكمَال التام في فعلٍ كمَالُه لله",
      "bbox": {
        "y": 1066.354,
        "x": 132.222,
        "width": 866.79,
        "height": 74
      }
    },
    {
      "bbox": {
        "x": 751.444,
        "y": 1144.172,
        "height": 56.439,
        "width": 305.194
      },
      "text": "عَزَّوَجَلَّ وليسَ للمَخلوق!"
    },
    {
      "bbox": {
        "y": 1226.933,
        "height": 73.905,
        "width": 877.832,
        "x": 127.898
      },
      "text": "فعندما يُقال: قاضِي القُضاة؛ معناه: أكمَل القضَاة، ورئيسُ القضاة جميعًا،"
    },
    {
      "text": "ومَن يمضي حكمه علىٰ جميع القضَاة!",
      "bbox": {
        "width": 482.155,
        "y": 1316.054,
        "height": 61.57,
        "x": 582.177
      }
    },
    {
      "text": "والمَعلُوم أن اللّٰه عَرًّجَلَّ يَقضي بين الخلائِق، فإذا تسَمَّىٰ الإنسان بقاضِي",
      "bbox": {
        "width": 877.112,
        "y": 1398.147,
        "height": 72.02,
        "x": 133.362
      }
    },
    {
      "text": "القضاة؛ فمَعنىٰ ذلك أنه رئيسُ وكبيرُ القضاةِ مُطلقًا، وفي هذا إساءَةُ أدبٍ مع اللّٰه",
      "bbox": {
        "width": 941.228,
        "y": 1480.161,
        "height": 69.344,
        "x": 130.797
      }
    },
    {
      "text": "عَزَّوَجَلَّ.",
      "bbox": {
        "height": 51.308,
        "x": 969.44,
        "y": 1562.333,
        "width": 97.457
      }
    }
