        "y": 783.217,
        "width": 931.789,
        "height": 69.642
      },
      "text": "الفهم، الذي استباحوا به قتل كل من يرونه من الأعاجم -الأمريكان"
    },
    {
      "text": "والأوربيين- قد جر الضرر للإسلام والمسلمين من حيث يشعر أو لا يشعر",
      "bbox": {
        "width": 928.926,
        "y": 851.168,
        "x": 134.144,
        "height": 69.599
      }
    },
    {
      "text": "هؤلاء، وتوضيح ذلك:",
      "bbox": {
        "x": 778.381,
        "y": 926.215,
        "height": 54.308,
        "width": 279.657
      }
    },
    {
      "bbox": {
        "y": 1001,
        "height": 56.395,
        "x": 195.885,
        "width": 810.473
      },
      "text": "اعلم -وفقك اللّٰه لهدايته- أن الإسلام مستهدف من أعداء اللّٰه تعالى."
    },
    {
      "text": "وأن أعداء اللّٰه تعالى إنما يستهدفون معقل الإسلام الذي يستقبله المسلمون في",
      "bbox": {
        "width": 876.045,
