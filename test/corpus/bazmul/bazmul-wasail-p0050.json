        "x": 133.556,
        "height": 78.009
      }
    },
    {
      "text": "كل يوم خمس مرات، وهي مكة المكرمة، التي هي من المملكة العربية السعودية.",
      "bbox": {
        "x": 161.207,
        "height": 61.26,
        "width": 904.311,
        "y": 1144.091
