        "height": 63.15
      }
    },
    {
      "bbox": {
        "x": 495.83,
        "height": 72.74,
        "y": 637.204,
        "width": 506.961
      },
      "text": "ثالثًا: جروا الضرر إلى الإسلام والمسلمين."
    },
    {
      "text": "إن الذين فهموا الحديث في إخراج المشركين من جزيرة العرب على ذاك",
      "bbox": {
        "x": 129.774,
        "y": 722,
